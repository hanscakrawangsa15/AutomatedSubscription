    "node": "hardhat node",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:bsc": "hardhat run scripts/deploy.js --network bsc",
    "keeper": "hardhat run scripts/keeper.js --network localhost",
    "keeper:base": "hardhat run scripts/keeper.js --network base",
    "keeper:mainnet": "hardhat run scripts/keeper.js --network mainnet",
    "keeper:bsc": "hardhat run scripts/keeper.js --network bsc",
    "keeper:mainnet-usdt": "KEEPER_TOKEN_SUFFIX=_USDT hardhat run scripts/keeper.js --network mainnet",
    "keeper:mainnet-weth": "KEEPER_TOKEN_SUFFIX=_WETH hardhat run scripts/keeper.js --network mainnet",
    "keeper:base-weth": "KEEPER_TOKEN_SUFFIX=_WETH hardhat run scripts/keeper.js --network base",
    "keeper:bsc-wbnb": "KEEPER_TOKEN_SUFFIX=_WBNB hardhat run scripts/keeper.js --network bsc",
    "keeper:solana-devnet": "node scripts/keeper.solana.js",
    "server": "node server/index.js"
  },
