# Mainnet-only build — this app is wired to real-money chains only (Base,
# Ethereum Mainnet, BNB Chain). No testnet toggle exists in the UI; a paid RPC provider is required for each chain
# below (Alchemy/Infura/QuickNode) — the app throws at startup if one is
# missing, by design (no silent fallback to an unreliable public RPC for
# real money). Use a SEPARATE app/key per chain — one shared key's rate
# limit is pooled across all three and gets exhausted fast under real
# traffic.
VITE_BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
VITE_ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
VITE_BSC_MAINNET_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/<key>

# Per-chain contract addresses, keyed by chainId — printed by each
# `npm run deploy:*` command at repo root. A second payment token on the
# same chain (e.g. USDT/WETH alongside the primary) is a second
# SubscriptionManager deployment, keyed by a suffix — e.g.
# VITE_USDC_ADDRESS_1_USDT, VITE_SUBSCRIPTION_MANAGER_ADDRESS_1_USDT.
#   8453  Base            — payment token: USDC
#   1     Ethereum Mainnet — payment token: USDC
#   56    BNB Chain        — payment token: USDT (Binance-Peg BSC-USD, 18
#                            decimals — BNB Chain has no Circle-native USDC;
#                            see docs/mainnet-addresses.md). The env var
#                            below is still named VITE_USDC_ADDRESS_56 for
#                            consistency — it points at the USDT contract.
#
# VITE_USDC_ADDRESS_8453=
# VITE_SUBSCRIPTION_MANAGER_ADDRESS_8453=
# VITE_USDC_ADDRESS_1=
# VITE_SUBSCRIPTION_MANAGER_ADDRESS_1=
# VITE_USDC_ADDRESS_56=
# VITE_SUBSCRIPTION_MANAGER_ADDRESS_56=

# Required for the "Connect Wallet" modal (WalletConnect/Reown AppKit).
# Get a free Project ID at https://cloud.reown.com, then paste it here.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: base URL of the local notification server (`npm run server` at repo root).
# VITE_NOTIFY_API_URL=http://localhost:4000
