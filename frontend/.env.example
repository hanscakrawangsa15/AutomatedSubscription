# Per-chain contract addresses, keyed by chainId. Add a pair for each
# network you've deployed to (run `npm run deploy:<network>` at repo root
# and copy the printed values here). Supported chain IDs:
#   31337     Hardhat Local
#   84532     Base Sepolia
#   11155111  Ethereum Sepolia
#   97        BSC Testnet
#   8453      Base (mainnet)        — payment token: USDC
#   1         Ethereum Mainnet      — payment token: USDC
#   56        BNB Chain (mainnet)   — payment token: USDT (Binance-Peg BSC-USD,
#                                      18 decimals — BNB Chain has no Circle-native
#                                      USDC; see docs/mainnet-addresses.md). The env
#                                      var below is still named VITE_USDC_ADDRESS_56
#                                      for consistency — it points at the USDT
#                                      contract for this chain, not USDC.
#
# VITE_USDC_ADDRESS_31337=
# VITE_SUBSCRIPTION_MANAGER_ADDRESS_31337=

# Local Hardhat network identity (used for the Time Travel dev tool and the
# default read-only provider before a wallet connects).
VITE_LOCAL_CHAIN_ID=31337
VITE_LOCAL_CHAIN_NAME=Hardhat Local
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545

# --- Network mode switch ---
# "testnet" (default, or unset): exposes Hardhat Local + Base Sepolia +
#   Ethereum Sepolia + BSC Testnet. Shows the dev tools panel.
# "mainnet": exposes ONLY Base + Ethereum Mainnet + BNB Chain (real funds).
#   Hides the dev tools panel entirely. Requires the three paid RPC URLs
#   below to be set — the app throws at startup otherwise (no silent
#   fallback to a public RPC for real money).
# Build separately for each: `npm run build` (testnet) vs `npm run build:mainnet`.
VITE_NETWORK_MODE=testnet

# Paid RPC provider URLs (Alchemy/Infura/QuickNode) — required when
# VITE_NETWORK_MODE=mainnet. Not used in testnet mode.
# VITE_BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# VITE_ETH_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
# VITE_BSC_MAINNET_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/<key>

# --- TRON ---
# Not chainId-keyed like VITE_USDC_ADDRESS_<chainId> above — TRON networks
# aren't identified that way. The TRON tab uses TronLink (a separate wallet
# ecosystem from AppKit's eip155 wallets, no relation to
# VITE_WALLETCONNECT_PROJECT_ID below) and its own read-only RPC
# (VITE_TRON_FULL_HOST) for plan pricing before connecting.
#
# VITE_TRON_NETWORK_MODE: "testnet" (default, or unset) or "mainnet" —
# independent from VITE_NETWORK_MODE above (EVM has its own toggle; you can
# have EVM on mainnet while TRON is still on testnet, or vice versa).
# "mainnet" hides the mint-test-USDT dev tools panel (real USDT has no
# public mint) and switches the default RPC to api.trongrid.io.
VITE_TRON_NETWORK_MODE=testnet

# Testnet (Nile) — printed by `npm run deploy:tron-nile` (see tron/tronbox.js):
# VITE_TRON_FULL_HOST=https://nile.trongrid.io
# VITE_TRON_NILE_USDC_ADDRESS=
# VITE_TRON_NILE_MANAGER_ADDRESS=

# Mainnet — VITE_TRON_MAINNET_USDT_ADDRESS is the real, verified Tether
# USDT TRC20 contract (see docs/mainnet-addresses.md for the verification
# record — confirm it yourself on tronscan.org before trusting it blindly).
# VITE_TRON_MAINNET_MANAGER_ADDRESS is left blank on purpose: SubscriptionManager
# has NOT been deployed to TRON Mainnet yet (needs a security audit for the
# TVM build first, same bar as the other mainnet chains) — the app shows a
# "not deployed" banner in mainnet mode until this is set.
# VITE_TRON_MAINNET_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# VITE_TRON_MAINNET_MANAGER_ADDRESS=

# Required for the "Connect Wallet" modal (WalletConnect/Reown AppKit).
# Get a free Project ID at https://cloud.reown.com, then paste it here.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: base URL of the local notification server (`npm run server` at repo root).
# VITE_NOTIFY_API_URL=http://localhost:4000
VITE_NOTIFY_API_URL=
