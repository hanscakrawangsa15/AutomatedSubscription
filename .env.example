# Notification server
NOTIFY_PORT=4000

# Resend (https://resend.com) — used by the keeper to email renewal receipts.
# Leave RESEND_API_KEY blank to disable email sending (keeper still charges fine).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# --- MySQL — subscribers table (server/index.js, scripts/keeper*.js) ---
# Written to once a subscribe() transaction confirms on-chain (wallet,
# chain, plan, tx hash, optional email/traffic source); read by the keeper
# scripts to know who to send renewal receipts to.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Local Hardhat dev chain (npm run node / deploy:local) ---
DEPLOYER_PRIVATE_KEY=

# --- Mainnet deployment (REAL FUNDS — see the mainnet-readiness plan before using) ---
# Required, no public-RPC fallback by design: a paid provider is mandatory
# for production reliability (Alchemy/Infura/QuickNode). Use a SEPARATE app/
# key per chain — a shared key's rate limit is pooled across all three and
# gets exhausted fast under real traffic.
# BASE_RPC_URL=
# MAINNET_RPC_URL=
# BSC_RPC_URL=

# Per-network deployer key. Prefer a hardware wallet where your tooling
# supports it; at minimum use a key retired immediately after deploy +
# transferOwnership to a Safe multisig — never reuse the local dev key above.
# BASE_DEPLOYER_PRIVATE_KEY=
# MAINNET_DEPLOYER_PRIVATE_KEY=
# BSC_DEPLOYER_PRIVATE_KEY=

# Required for `npm run deploy:base` / `deploy:mainnet` / `deploy:bsc` to run
# at all — a deliberate confirmation gate, not a real secret.
# CONFIRM_MAINNET_DEPLOY=yes-i-am-sure

# The real, pre-verified payment token address per chain (see Phase 3 of the
# mainnet plan and docs/mainnet-addresses.md — verify against the issuer's
# own docs + the chain's block explorer, never hardcode from memory).
# Required for production deploys. The env var is always named
# USDC_ADDRESS_<chainId> for consistency across the codebase, but note BNB
# Chain's is USDT, not USDC — see docs/mainnet-addresses.md for why. A
# second payment token on the same chain (e.g. USDT/WETH alongside the
# primary) is a second SubscriptionManager deployment, keyed by a suffix —
# e.g. USDC_ADDRESS_1_USDT, SUBSCRIPTION_MANAGER_ADDRESS_1_USDT.
#   USDC_ADDRESS_8453=       # Base — USDC (Circle-native, 6 decimals)
#   USDC_ADDRESS_1=          # Ethereum Mainnet — USDC (Circle-native, 6 decimals)
#   USDC_ADDRESS_56=         # BNB Chain — Binance-Peg USDT, BEP-20, 18 decimals (no Circle-native USDC on BNB Chain)
#   SUBSCRIPTION_MANAGER_ADDRESS_<chainId>[_suffix]=
#   SUBSCRIPTION_MANAGER_DEPLOY_BLOCK_<chainId>[_suffix]=

# --- Solana (see the Solana integration plan) ---
# SOLANA_NETWORK_MODE: "devnet" (default) or "mainnet" — independent from
# the EVM VITE_NETWORK_MODE above. Mainnet needs its own program deploy +
# security review before use (see the plan doc).
# SOLANA_NETWORK_MODE=devnet
# SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# SOLANA_DEVNET_PROGRAM_ID=
# SOLANA_DEVNET_USDT_MINT=
# SOLANA_DEVNET_CONFIG=
# SOLANA_DEVNET_TREASURY_TOKEN_ACCOUNT=
# SOLANA_KEEPER_KEYPAIR_PATH=~/.config/solana/id.json

# --- Block explorer API keys (contract verification after deploy) ---
# ETHERSCAN_API_KEY=
# BASESCAN_API_KEY=
# BSCSCAN_API_KEY=

# --- CoinMarketCap API (reference pricing for non-stablecoin plans, e.g. WETH/WBNB) ---
# CMC_API_KEY=
