# Notification server
NOTIFY_PORT=4000

# Resend (https://resend.com) — used by the keeper to email renewal receipts.
# Leave RESEND_API_KEY blank to disable email sending (keeper still charges fine).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# --- Testnet deployment ---
# A wallet funded with that chain's testnet gas token (from a faucet), used
# to deploy contracts and run per-chain keepers. Required for
# `npm run deploy:base-sepolia` / `deploy:sepolia` / `deploy:bsc-testnet`.
DEPLOYER_PRIVATE_KEY=

# Optional: use a different funded account for a specific network instead of
# the shared DEPLOYER_PRIVATE_KEY above (e.g. if you have tBNB on a separate
# account). Each falls back to DEPLOYER_PRIVATE_KEY if left blank.
# BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
# SEPOLIA_DEPLOYER_PRIVATE_KEY=
# BSC_TESTNET_DEPLOYER_PRIVATE_KEY=

# Optional: override the public default RPC per chain (e.g. your own
# Alchemy/Infura endpoint for reliability).
# BASE_SEPOLIA_RPC_URL=
# SEPOLIA_RPC_URL=
# BSC_TESTNET_RPC_URL=

# Per-chain contract addresses for the keeper, printed by each deploy
# command above — e.g. after `npm run deploy:base-sepolia`:
#   SUBSCRIPTION_MANAGER_ADDRESS_84532=
#   USDC_ADDRESS_84532=
#   SUBSCRIPTION_MANAGER_DEPLOY_BLOCK_84532=
# (chain IDs: 31337 local, 84532 Base Sepolia, 11155111 Ethereum Sepolia, 97 BSC Testnet)

# --- TRON (Nile testnet) ---
# TRON isn't an EVM chain — no eth_* JSON-RPC, no Hardhat network config, a
# different (base58) address format. Deployed separately via TronBox (see
# tron/tronbox.js), not `npm run deploy:*` above.
#
# Get testnet TRX from https://nileex.io/join/getJoinPage for this address
# before running `npm run deploy:tron-nile`.
# TRON_NILE_DEPLOYER_PRIVATE_KEY=
#
# Optional: a separate hot key for scripts/keeper.tron.js. Falls back to
# TRON_NILE_DEPLOYER_PRIVATE_KEY if unset (fine for testnet).
# TRON_NILE_KEEPER_PRIVATE_KEY=
#
# Printed by `npm run deploy:tron-nile`:
# TRON_NILE_USDC_ADDRESS=
# TRON_NILE_MANAGER_ADDRESS=

# --- Mainnet deployment (REAL FUNDS — see the mainnet-readiness plan before using) ---
# Required, no public-RPC fallback by design: a paid provider is mandatory
# for production reliability (Alchemy/Infura/QuickNode).
# BASE_RPC_URL=
# MAINNET_RPC_URL=
# BSC_RPC_URL=

# Per-network deployer key. Prefer a hardware wallet where your tooling
# supports it; at minimum use a key retired immediately after deploy +
# transferOwnership to a Safe multisig — never the shared testnet-style key.
# BASE_DEPLOYER_PRIVATE_KEY=
# MAINNET_DEPLOYER_PRIVATE_KEY=
# BSC_DEPLOYER_PRIVATE_KEY=

# Required for `npm run deploy:base` / `deploy:mainnet` / `deploy:bsc` to run
# at all — a deliberate confirmation gate, not a real secret.
# CONFIRM_MAINNET_DEPLOY=yes-i-am-sure

# The real, pre-verified payment token address per chain (see Phase 3 of the
# mainnet plan and docs/mainnet-addresses.md — verify against the issuer's
# own docs + the chain's block explorer, never hardcode from memory).
# Required for production deploys. The env var is always named
# USDC_ADDRESS_<chainId> for consistency across the codebase, but note BNB
# Chain's is USDT, not USDC — see docs/mainnet-addresses.md for why.
#   USDC_ADDRESS_8453=       # Base — USDC (Circle-native, 6 decimals)
#   USDC_ADDRESS_1=          # Ethereum Mainnet — USDC (Circle-native, 6 decimals)
#   USDC_ADDRESS_56=         # BNB Chain — Binance-Peg USDT, BEP-20, 18 decimals (no Circle-native USDC on BNB Chain)
